# Copy this file to .env and fill in the values
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=skills_db
POSTGRES_USER=skills_user
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://skills_user:changeme@localhost:5432/skills_db
OPENAI_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1

# Language model and embeddings (any OpenAI-compatible API). Defaults are local Ollama:
# LLM_MODEL=llama3.2
# EMBED_BASE_URL=http://localhost:11434/v1     # defaults to LLM_BASE_URL
# EMBED_MODEL=nomic-embed-text
# EMBED_DIMENSIONS=                             # 768 for OpenAI text-embedding-3-small
